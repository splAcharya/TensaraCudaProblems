{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/tensara/run-manifest.schema.json",
  "title": "Tensara run manifest",
  "type": "object",
  "required": ["schema_version", "run_id", "status", "timestamp_utc",
               "command", "exit_status", "binary_sha256", "artifacts"],
  "properties": {
    "schema_version": {"const": 1},
    "run_id": {"type": "string", "minLength": 1},
    "status": {"enum": ["complete", "failed", "incomplete", "skipped"]},
    "timestamp_utc": {"type": "string", "format": "date-time"},
    "command": {"type": "array", "items": {"type": "string"}},
    "exit_status": {"type": "integer"},
    "git_commit": {"type": ["string", "null"]},
    "git_dirty": {"type": "boolean"},
    "binary_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "artifacts": {"type": "object"}
  },
  "additionalProperties": true
}
